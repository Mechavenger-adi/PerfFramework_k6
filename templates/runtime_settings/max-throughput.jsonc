{
  "$schema": "../../schemas/runtime_settings.schema.json",
  "_meta": {
    "title": "Max Throughput",
    "description": "Removes all think times and pacing. Generates load as fast as the injector network allows. Use with caution."
  },
  "thinkTime": { "mode": "fixed", "fixed": 0 },
  "pacing": { "enabled": false },
  "http": { "timeoutSeconds": 30, "maxRedirects": 10, "throwOnError": false },
  "errorBehavior": "continue",
  "reporting": {
    "transactionStats": ["count", "avg", "p(95)"],
    "includeTransactionTable": true,
    "includeErrorTable": false,
    "timeseries": { "enabled": true, "bucketSizeSeconds": 15 }
  },
  "errors": { "captureSnapshotOnFailure": false },
  "monitoring": { "enabled": false },
  "debugMode": false
}
