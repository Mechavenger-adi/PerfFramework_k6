{
  "$schema": "../../schemas/runtime_settings.schema.json",
  "_meta": {
    "title": "Strict SLA Validation",
    "description": "Fails the test immediately if any error occurs. Good for very strict acceptance criteria."
  },
  "thinkTime": { "mode": "random", "min": 0.5, "max": 2.0 },
  "pacing": { "enabled": false },
  "http": { "timeoutSeconds": 10, "maxRedirects": 5, "throwOnError": true },
  "errorBehavior": "abort_test",
  "reporting": {
    "transactionStats": ["count", "fail", "p(90)", "p(95)", "p(99)", "max"],
    "includeTransactionTable": true,
    "includeErrorTable": true,
    "timeseries": { "enabled": true, "bucketSizeSeconds": 10 }
  },
  "errors": { "captureSnapshotOnFailure": true, "maxSnapshotsPerRun": 5 },
  "monitoring": { "enabled": true, "cpuWarningPercent": 70, "memoryWarningPercent": 70, "sampleIntervalSeconds": 10 },
  "debugMode": false
}
