{
  "$schema": "../../schemas/runtime_settings.schema.json",
  "_meta": {
    "title": "CI Pipeline",
    "description": "Optimized for running in Jenkins/GitLab. Fails fast on errors, generates summary tables, and skips expensive debug snapshots."
  },
  "thinkTime": { "mode": "fixed", "fixed": 1 },
  "pacing": { "enabled": false },
  "http": { "timeoutSeconds": 30, "maxRedirects": 5, "throwOnError": true },
  "errorBehavior": "abort_test",
  "reporting": {
    "transactionStats": ["count", "pass", "fail", "p(90)", "p(95)"],
    "includeTransactionTable": true,
    "includeErrorTable": true,
    "timeseries": { "enabled": false }
  },
  "errors": { "captureSnapshotOnFailure": false },
  "monitoring": { "enabled": false },
  "debugMode": false
}
