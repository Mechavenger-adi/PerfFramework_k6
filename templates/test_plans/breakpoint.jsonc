{
  "$schema": "../../schemas/test-plan.schema.json",
  "_meta": {
    "title": "Breakpoint Test",
    "description": "Slowly increases load indefinitely until the system crashes or SLAs are severely broken to find the absolute maximum capacity."
  },
  "name": "Breakpoint Test",
  "environment": "dev",
  "execution_mode": "parallel",
  "global_load_profile": {
    "executor": "ramping-vus",
    "startVUs": 0,
    "stages": [
      // Keep ramping up for a long time
      { "duration": "2h", "target": 10000 }
    ]
  },
  "user_journeys": [
    {
      "name": "example_journey",
      "scriptPath": "testSuites/sample_team/tests/example.js",
      "weight": 100
    }
  ]
}
