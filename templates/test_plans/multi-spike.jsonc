{
  "$schema": "../../config/schemas/test_plan.schema.json",
  "_meta": {
    "title": "Multi-Spike Test",
    "description": "Delivers repeated traffic spikes with recovery periods between each. Good for testing cumulative degradation and memory leak detection under repeated high-load events."
  },
  "name": "Multi-Spike Test",
  "environment": "dev",
  "execution_mode": "parallel",
  "global_load_profile": {
    "executor": "ramping-vus",
    "startVUs": 0,
    "stages": [
      // Baseline
      { "duration": "1m",  "target": 10 },
      // Spike 1
      { "duration": "15s", "target": 150 },
      { "duration": "1m",  "target": 150 },
      // Recovery 1
      { "duration": "15s", "target": 10 },
      { "duration": "2m",  "target": 10 },
      // Spike 2
      { "duration": "15s", "target": 150 },
      { "duration": "1m",  "target": 150 },
      // Recovery 2
      { "duration": "15s", "target": 10 },
      { "duration": "2m",  "target": 10 },
      // Spike 3
      { "duration": "15s", "target": 150 },
      { "duration": "1m",  "target": 150 },
      // Final ramp down
      { "duration": "30s", "target": 0 }
    ]
  },
  "user_journeys": [
    {
      "name": "example_journey",
      "scriptPath": "testSuites/sample_team/tests/example.js",
      "weight": 100
    }
  ],
  "global_sla": {
    "p95": 4000,
    "errorRate": 2
  }
}
