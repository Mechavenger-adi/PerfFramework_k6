{
  "$schema": "../../config/schemas/test_plan.schema.json",
  "_meta": {
    "title": "Step-Up (Staircase) Test",
    "description": "Increases load in discrete steps with holds at each level. Good for identifying the exact VU count where performance degrades."
  },
  "name": "Step-Up Test",
  "environment": "dev",
  "execution_mode": "parallel",
  "global_load_profile": {
    "executor": "ramping-vus",
    "startVUs": 0,
    "stages": [
      // Step 1: ramp to 10 VUs, hold 3 minutes
      { "duration": "30s", "target": 10 },
      { "duration": "3m",  "target": 10 },
      // Step 2: ramp to 25 VUs, hold 3 minutes
      { "duration": "30s", "target": 25 },
      { "duration": "3m",  "target": 25 },
      // Step 3: ramp to 50 VUs, hold 3 minutes
      { "duration": "30s", "target": 50 },
      { "duration": "3m",  "target": 50 },
      // Step 4: ramp to 100 VUs, hold 3 minutes
      { "duration": "30s", "target": 100 },
      { "duration": "3m",  "target": 100 },
      // Ramp down
      { "duration": "1m",  "target": 0 }
    ]
  },
  "user_journeys": [
    {
      "name": "example_journey",
      "scriptPath": "testSuites/sample_team/tests/example.js",
      "weight": 100
    }
  ],
  "global_sla": {
    "p95": 3000,
    "errorRate": 1
  }
}
