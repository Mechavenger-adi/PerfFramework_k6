{
  "name": "Ramping Arrival Rate Template",
  "environment": "dev",
  "execution_mode": "parallel",
  "global_load_profile": {
    "executor": "ramping-arrival-rate",
    "timeUnit": "1s",
    "preAllocatedVUs": 20,
    "maxVUs": 100,
    "stages": [
      { "duration": "2m", "target": 20 },
      { "duration": "5m", "target": 50 },
      { "duration": "2m", "target": 0 }
    ]
  },
  "user_journeys": [
    {
      "name": "example_journey",
      "scriptPath": "example-journey.js",
      "weight": 100
    }
  ],
  "global_sla": {
    "p95": 3000,
    "errorRate": 5
  }
}
