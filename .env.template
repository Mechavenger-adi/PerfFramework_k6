# .env template — copy to .env and fill in values
# NEVER commit .env to source control

# ── Target Environment (optional) ───────────────
# Per-team base URLs normally live in config/environments/*.json. Uncomment
# K6_BASE_URL to set a global fallback base URL used when a script resolves a
# relative path with no team/service URL available.
# K6_BASE_URL=https://your-dev-environment.com

# ── Auth / API Keys (optional) ──────────────────
# Exposed to VU scripts via getApiKey() from utils/session.js — use it to build
# an auth header (e.g. Authorization: Bearer <key>).
# K6_API_KEY=your-api-key-here

# -- Reporting & InfluxDB Setup -----------------
# Directory for timestamped HTML/JSON run reports.
# Accepts a relative (resolved against the framework root) or absolute path.
#K6_RESULTS_BASE_DIR=./testSuites/results

# Per-request CSV log: one row per HTTP request, written live to the run's report
# dir as <testId>_<hostname>_request_metric.csv. ON by default. Enabling it also
# turns on k6's vu/iter system tags (so the log can record current VU + iteration),
# which slightly enlarges metrics-stream.json. Set to 0/false/no to turn it off.
# K6_PERF_REQUEST_LOG=0

# Per-transaction CSV log: one row per transaction iteration, written live as
# <testId>_<hostname>_transaction_metric.csv. Columns include IsPass (checks-first)
# and responsetime (the transaction's own duration, seconds). Shares the same
# vu/iter system tags as the request log. ON by default; set to 0/false/no to disable.
# K6_PERF_TRANSACTION_LOG=0

# Uncomment and set to stream metrics natively to a local or remote InfluxDB instance (Option A for PowerBI/Grafana)
# K6_INFLUXDB_URL=http://localhost:8086/k6

# ── Distributed Load Test (Phase 1 — manual) ─────────────────────────────
# Runbook: docs/distributed-loadtest-runbook.md
# Leave everything below UNSET for normal single-machine runs (zero behavior change).
# With these set in .env, the run command on each LG is simply:
#   node dist/cli/run.js run --plan config/test_plans/load_test.json
# (or add --distributed --role agent on the command line instead of the env vars).

# Turn on distributed mode. 1/true/yes. (Or pass --distributed on the CLI.)
# K6_PERF_DISTRIBUTED=1

# This machine's role: agent (a load generator) or controller (watches + merges).
# (Or pass --role agent|controller on the CLI.)
# K6_PERF_ROLE=agent

# This machine's name — per-machine folder + metric tag. MUST be UNIQUE per LG.
# Defaults to the OS hostname when unset.
# K6_PERF_MACHINE=lg-a

# Shared run id, IDENTICAL on every machine so their results group together.
# If unset, it is derived from K6_PERF_START_AT (so all machines agree automatically).
# K6_PERF_RUN_ID=load_2026_07_20_1430

# Shared test id (metric tag + CSV filename prefix). SAME on every machine; the merge
# warns if they differ. Unset = derived from the plan name as TID_<plan>.
# K6_PERF_TEST_ID=TID_checkout_smoke

# Shared wall-clock start (ISO 8601, UTC). Each LG waits until this instant before
# launching k6 so ramps align. Also auto-derives the shared runId while it is still
# upcoming. Unset / already-past = start now with a fresh run folder.
# K6_PERF_START_AT=2026-07-20T14:30:00Z

# The shared folder (UNC on Windows). Live heartbeats go to <DIR>/live_<runId>/ during
# the run; the full results are copied to <DIR>/shared_<runId>/<machine>/ at the end.
# K6_PERF_COLLECT_DIR=\\CTRL01\k6results

# k6 REST API address used for graceful mid-test stop (default 127.0.0.1:6565). Only
# change if a machine runs more than one k6 at once.
# K6_PERF_K6_API=127.0.0.1:6565

# Force per-machine histogram emission even without K6_PERF_MACHINE (1/true).
 K6_PERF_EMIT_HISTOGRAM=1

# Histogram tuning (advanced; must match on every machine for the merge to align):
#   ALPHA  = relative accuracy (default 0.001 = 0.1% / 3 significant figures)
#   BUCKET = histogram time-bucket seconds (default: adaptive from planned duration)
# K6_PERF_HISTOGRAM_ALPHA=0.001
# K6_PERF_HISTOGRAM_BUCKET=10
