{
  "name": "@k6-perf/core_engine",
  "version": "1.0.0",
  "description": "k6 Performance Framework – Core Engine (Phase 1 Foundation)",
  "keywords": [
    "k6",
    "performance",
    "testing",
    "framework"
  ],
  "homepage": "https://github.com/<your-org>/K6-PerfFramework#readme",
  "bugs": {
    "url": "https://github.com/<your-org>/K6-PerfFramework/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/<your-org>/K6-PerfFramework.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "k6-framework": "dist/cli/run.js"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "cli": "tsx core_engine/src/cli/run.ts",
    "watch": "tsx watch core_engine/src/cli/run.ts",
    "init": "tsx core_engine/src/cli/run.ts init",
    "new": "tsx core_engine/src/cli/run.ts new",
    "docs": "tsx core_engine/src/cli/run.ts docs",
    "templates": "tsx core_engine/src/cli/run.ts templates",
    "generate": "tsx core_engine/src/cli/run.ts generate",
    "generate:byos": "tsx core_engine/src/cli/run.ts generate-byos",
    "convert": "tsx core_engine/src/cli/run.ts convert",
    "import": "tsx core_engine/src/cli/run.ts import",
    "import:curl": "tsx core_engine/src/cli/run.ts import curl",
    "import:postman": "tsx core_engine/src/cli/run.ts import postman",
    "validate": "tsx core_engine/src/cli/run.ts validate",
    "debug:script": "tsx core_engine/src/cli/run.ts debug",
    "run": "tsx core_engine/src/cli/run.ts run",
    "loadtest": "npm run cli -- run --plan config/test_plans/load_test.json",
    "debug": "npm run cli -- run --plan config/test_plans/debug_test.json"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "jsonc-parser": "^3.3.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/k6": "^2.0.0",
    "@types/node": "^22.13.10",
    "@types/yargs": "^17.0.33",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2"
  }
}
